@BackendApi_HostAddress = http://localhost:7047

GET {{BackendApi_HostAddress}}/api/status
Accept: application/json

###

GET {{BackendApi_HostAddress}}/api/drillholes
Accept: application/json

###

# All nine Raw Litho lookup lists in one response.
GET {{BackendApi_HostAddress}}/api/table-constants
Accept: application/json

###

# Read-only: the stored CoreDescrData rows of one drillhole (HOLEID).
GET {{BackendApi_HostAddress}}/api/dataviewer?drillhole=GTZO_0001_1
Accept: application/json

###

# Upload Data: multipart/form-data with one field, "file" (a .json export).
# This runs dbo.InsertUpdateCoreDescr_WellCAD in CoreDescrData:Database
# (ACQMN01_DEV), so it writes to that database. Send it only to an approved development database.
POST {{BackendApi_HostAddress}}/api/upload-data
Content-Type: multipart/form-data; boundary=UploadBoundary

--UploadBoundary
Content-Disposition: form-data; name="file"; filename="DH-001.json"
Content-Type: application/json

{
  "project": "Project A",
  "campaign": "Campaign 2026",
  "drillhole": "DH-001",
  "created_at": "2026-08-06T09:15:00Z",
  "modified_at": "2026-08-06T14:30:00Z",
  "rows": [
    {
      "id": 1,
      "extractionType": "",
      "corePass": "1",
      "recoveryStart": "",
      "recoveryEnd": "",
      "coreEnd": "",
      "lithoFrom": "10",
      "lithoTo": "12",
      "lithoCode": "0--",
      "colorCode": "10G4/2",
      "ca": "",
      "om": "",
      "omFacies": "",
      "py": "",
      "ox": "",
      "sedim": "",
      "redoxCode": "0042_MN1",
      "granulo": "",
      "hardness": "",
      "lithologyComments": "",
      "lithologicalDescription": ""
    }
  ]
}
--UploadBoundary--

