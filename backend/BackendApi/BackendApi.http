# Upload Data: multipart/form-data with one field, "file" (a .json export).
# This runs dbo.InsertUpdateCoreDescr_WellCAD against DefaultConnection, so it
# writes to that database. Send it only to an approved development database.
POST {{BackendApi_HostAddress}}/api/upload-data
Content-Type: multipart/form-data; boundary=UploadBoundary

--UploadBoundary
Content-Disposition: form-data; name="file"; filename="DH-001.json"
Content-Type: application/json

{
  "project": "Project A",
  "campaign": "Campaign 2026",
  "drillhole": "DH-001",
  "created_at": "2026-08-06T09:15:00Z",
  "modified_at": "2026-08-06T14:30:00Z",
  "rows": [
