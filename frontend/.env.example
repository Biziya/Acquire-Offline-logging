# Development-only proxy; match the address of your existing ASP.NET backend.
VITE_API_PROXY_TARGET=http://localhost:7047
# Production API origin. Leave empty when frontend and /api share an origin.
VITE_API_BASE_URL=
# Trusted identity endpoint on the API that returns { "userName": "DOMAIN\username" }
# from Windows Integrated Authentication (e.g. /api/currentuser). Leave empty while
# the backend has none: Created By / Imported By then show "Unavailable".
VITE_CURRENT_USER_PATH=
