# Development-only proxy; match the address of your existing ASP.NET backend.
VITE_API_PROXY_TARGET=http://localhost:7047
# Production API origin. Leave empty when frontend and /api share an origin.
VITE_API_BASE_URL=
# Trusted identity endpoint: the backend's GET /api/currentuser returns the
# Windows user proven by Windows Integrated Authentication, as
# { "userName": "BEK" } (local account) or { "userName": "COMPANY\bek" } (domain).
# Empty disables the lookup: the sidebar then shows "User not identified".
VITE_CURRENT_USER_PATH=/api/currentuser
